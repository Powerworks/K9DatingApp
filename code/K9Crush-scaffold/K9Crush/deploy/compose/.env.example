# Copy this file to .env (in this same folder) and fill in real values.
# .env is gitignored - never commit real secrets here.

# From your Supabase project (Project Settings -> Database -> Connection
# string -> SESSION POOLER or DIRECT, never "Transaction pooler" - see
# GETTING_STARTED.md Step 2 for why this matters).
# Npgsql format: Host=...;Port=...;Database=...;Username=...;Password=...;SSL Mode=Require;Trust Server Certificate=true
SUPABASE_POSTGRES_CONNECTION_STRING=

# From Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# From Project Settings -> API -> JWT Settings
SUPABASE_JWT_SECRET=

# Pick real credentials - do not use "guest"/"guest" here, that's a
# local-dev-only convention.
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Domain pointed (A record) at this box's public IP - Caddy requests a
# Let's Encrypt cert for exactly this name on first start. Must already
# resolve before Caddy starts or the ACME challenge fails.
DOMAIN=

# Which registry/tag docker compose pulls images from - only relevant if
# you're deploying pre-built images (this is what cd.yml sets on every
# deploy). Leave REGISTRY as the default and IMAGE_TAG=latest for a plain
# local `docker compose ... up -d --build`, which ignores both anyway.
REGISTRY=ghcr.io/powerworks
IMAGE_TAG=latest
