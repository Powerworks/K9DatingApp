<Project Sdk="Microsoft.NET.Sdk">

  <!-- Class library (Wolverine.Http handlers, no Program.cs of its own -
       Api.Host is what actually runs) - needs FrameworkReference for
       ASP.NET Core types, not Sdk.Web which implies an entry point. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="WolverineFx.Http" />
    <PackageReference Include="Marten" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\K9Crush.Modules.Chat.Domain\K9Crush.Modules.Chat.Domain.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\K9Crush.BuildingBlocks.Web\K9Crush.BuildingBlocks.Web.csproj" />

    <!-- Cross-module reference: Contracts ONLY, never Discovery.Domain/Api.
         MatchCreatedV1 (CreateConversationOnMatchHandler's trigger). This
         module doesn't have its own Contracts project yet - it publishes
         nothing cross-module in this first increment (SendMessage/
         MarkAsRead stay local; a future NotifyOnMessage automation would
         need one added then, not speculatively now). -->
    <ProjectReference Include="..\..\Discovery\K9Crush.Modules.Discovery.Contracts\K9Crush.Modules.Discovery.Contracts.csproj" />
  </ItemGroup>

</Project>
