<Project Sdk="Microsoft.NET.Sdk">

  <!-- Class library (Wolverine.Http handlers, no Program.cs of its own -
       Api.Host is what actually runs) - needs FrameworkReference for
       ASP.NET Core types, not Sdk.Web which implies an entry point. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="WolverineFx.Http" />
    <PackageReference Include="Marten" />
  </ItemGroup>

  <ItemGroup>
    <!-- A module's Api project may reference: its own Domain, its own
         Contracts (this module doesn't have one yet - it publishes
         nothing cross-module so far), BuildingBlocks (any), and OTHER
         MODULES' Contracts ONLY (never another module's Domain/Api/
         Infrastructure). Identity.Contracts is needed for
         FeedbackSubmittedV1 - FeedbackSubmittedProjectorHandler's trigger. -->
    <ProjectReference Include="..\K9Crush.Modules.Admin.Domain\K9Crush.Modules.Admin.Domain.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\K9Crush.BuildingBlocks.Web\K9Crush.BuildingBlocks.Web.csproj" />
    <ProjectReference Include="..\..\Identity\K9Crush.Modules.Identity.Contracts\K9Crush.Modules.Identity.Contracts.csproj" />
  </ItemGroup>

</Project>
